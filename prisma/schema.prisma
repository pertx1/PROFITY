// PROFITY — gastos, pedidos y beneficio de tu negocio.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  // Conexión con Antola: solo se guarda el hash (SHA-256) de la clave.
  antolaTokenHash      String?   @unique
  antolaTokenCreatedAt DateTime?

  expenses     Expense[]
  orders       Order[]
  incomes      Income[]
  tshirtStocks TshirtStock[]
  dtfStocks    DtfStock[]
  vintedItems  VintedItem[]
  invoices     Invoice[]
  shirtDtfRules  ShirtDtfRule[]
  designDtfRules DesignDtfRule[]
  printBagChecks PrintBagCheck[]
}

// Regla general "color de camiseta → color del DTF" para colores distintos
// de blanco/negro. shirtColorKey es el color normalizado (sin acentos, en
// minúsculas) para poder casar con lo escrito en los pedidos.
model ShirtDtfRule {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shirtColor    String
  shirtColorKey String
  dtfColor      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, shirtColorKey])
}

// DTF especial de un diseño (p. ej. a todo color): tiene prioridad sobre la
// regla por color de camiseta.
model DesignDtfRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  design    String
  dtfColor  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, design])
}

// Línea marcada en la "Bolsa para la imprenta". Se guarda la cantidad que
// tenía al marcarla para detectar si ha cambiado después.
model PrintBagCheck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  quantity  Int
  checkedAt DateTime @default(now())

  @@unique([userId, key])
}

model Invoice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model Expense {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  category      String
  concept       String?
  amount        Float
  paymentMethod String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  vintedItem    VintedItem?

  @@index([userId, date])
  @@index([userId, category])
}

model Income {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  source      String
  concept     String?
  amount      Float
  method      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  vintedItem  VintedItem?

  @@index([userId, date])
  @@index([userId, source])
}

enum VintedType {
  COMPRA
  VENTA
}

model VintedItem {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VintedType
  name      String
  size      String?
  price     Float
  date      DateTime
  expenseId String?    @unique
  expense   Expense?   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  incomeId  String?    @unique
  income    Income?    @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, type])
}

enum OrderStatus {
  SIN_HACER
  EN_CASA
  EN_PAQUETE
  ENVIADO
  SIN_LLEGAR
  CANCELADO
}

enum TshirtModel {
  BLANCA
  NEGRA
  FUTBOL
  SUDADERA_NEGRA
}

enum DtfVariant {
  UNICO
  BLANCO
  NEGRO
}

model TshirtStock {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  model     TshirtModel
  size      String
  quantity  Int         @default(0)
  updatedAt DateTime    @updatedAt

  @@unique([userId, model, size])
  @@index([userId])
}

model DtfStock {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  variant   DtfVariant
  quantity  Int        @default(0)
  updatedAt DateTime   @updatedAt

  @@unique([userId, name, variant])
  @@index([userId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderNumber String?
  date        DateTime    @default(now())
  quantity    Int         @default(1)
  model       String
  color       String?
  size        String?
  price       Float
  status      OrderStatus @default(SIN_HACER)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, date])
  @@index([userId, model])
  @@index([userId, status])
}
